# llama-cpp-python OpenAI-compatible server on the NVIDIA GPU (CUDA 12.x, prebuilt cu124 wheel - no compilation).
# Requires Docker Desktop with WSL2 + NVIDIA driver. Without a GPU use Dockerfile.llm-cpu.
# 0.3.4 is the last release with prebuilt CUDA wheels; its chat endpoint misses an `await` (fixed upstream later),
# so that one line is patched below - otherwise every chat request fails with "'coroutine' object is not callable".
FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --break-system-packages "llama-cpp-python[server]==0.3.4" \
    --extra-index-url https://abetlen.github.io/llama-cpp-python/whl/cu124 \
    && sed -i 's/llama_proxy = exit_stack.enter_async_context/llama_proxy = await exit_stack.enter_async_context/' \
       /usr/local/lib/python3.12/dist-packages/llama_cpp/server/app.py \
    && grep -q "await exit_stack.enter_async_context" /usr/local/lib/python3.12/dist-packages/llama_cpp/server/app.py
EXPOSE 8080
# model file from ./models, chosen in .env: LLM_MODEL_FILE (3B by default; 7B = qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf)
ENV LLM_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
CMD python3 -m llama_cpp.server --model "/models/${LLM_MODEL_FILE}" --chat_format chatml --n_ctx 8192     --n_gpu_layers -1 --host 0.0.0.0 --port 8080
