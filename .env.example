# Copy to .env and adjust
NRG_NEGATIVE_THRESHOLD=60
NRG_AVG_UNIT_PRICE_USD=40
NRG_APPROVAL_COST_THRESHOLD_K=50

# AI agent: local GGUF model via llama-cpp-python (pip install -r requirements-llm.txt ...)
LLM_MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
# Set to use a llama_cpp.server instead of loading the model in-process (Docker: http://llm:8080)
LLM_BASE_URL=
# Local run + GPU server from Docker: LLM_BASE_URL=http://localhost:8081
LLM_N_CTX=8192

# n8n webhooks (leave empty -> events are written to data/outbox.jsonl)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/nrg-action
N8N_DECISION_WEBHOOK_URL=http://localhost:5678/webhook/nrg-decision
# Public URL of the API (used in approve/reject links in e-mails)
NRG_API_PUBLIC_URL=http://localhost:8000
NRG_APPROVAL_SECRET=change-me-to-a-long-random-string

# E-mail (used by n8n). With Mailpit leave as is; for Gmail put your address everywhere and set the SMTP
# credential in n8n (README -> E-mail)
NRG_MAIL_FROM=nrg-bot@example.com
NRG_MANAGER_EMAIL=manager@example.com
NRG_TEAM_EMAIL=dev-team@example.com

# Google Sheets log (README -> Google Sheets): spreadsheet id from its URL .../spreadsheets/d/<ID>/edit
NRG_GSHEET_ID=

# LLM in Docker (file in ./models). 7B (better comments, ~6 GB VRAM, slower):
#   LLM_MODEL_FILE=qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf   LLM_NAME=qwen2.5-7b-instruct-q4_k_m
LLM_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
LLM_NAME=qwen2.5-3b-instruct-q4_k_m
